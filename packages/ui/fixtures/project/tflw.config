# The fixture project behind `packages/ui`'s page gate (`M192` U2). Small on purpose: every
# construct here is one the page renders — a passing test, a failing assertion with its got/
# expected, a capture, a log, a retry that passes on its second attempt, a header assertion —
# against `server.mjs` beside it. `scripts/make-fixtures.mjs` runs it under each env and keeps
# the report directories as the corpus the gate reads as its oracle.
defaults
  timeout api 5s
  viewport 640 400
  authorized target "http://127.0.0.1:4717" reason "the fixture server beside this file"

env full default
  api "http://127.0.0.1:4717"
  web "http://127.0.0.1:4717"

env headers
  api "http://127.0.0.1:4717"
  web "http://127.0.0.1:4717"
  evidence headers only
  # `M208` `S1`/`S2`. Declared here rather than in `defaults`, and that placement is the whole
  # point of the key being per-env: the two corpora exist to hold the SAME finding once gating
  # (`full`) and once withheld as known/accepted (`headers`), and a `defaults` line would baseline
  # it in both and delete the contrast the page gate reads as its oracle. It replaces the
  # `--baseline` flag `make-fixtures.mjs` used to pass for this env alone — same document, same
  # verdicts, now said in the file a reviewer opens.
  baseline "./security-baseline.json"
