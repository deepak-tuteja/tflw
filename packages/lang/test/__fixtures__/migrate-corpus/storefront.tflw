@mixed
test "the Category <select> really filters the catalog, combined with Search"
  # M40 (PLAN_WEBV2_M40.md): closes the `select "…" from field` gap — CatalogPage.tsx's Category
  # <select> (a real <label>-associated element, tier 1) was never exercised by any test. Combined
  # with Search rather than asserted alone, so a wrong category genuinely proves 0 results and the
  # right one proves 1 — not just "the dropdown didn't error".
  login(env(USER_A_EMAIL), env(USER_A_PW))
  open "/"
  select "Books" from field "Category"
  fill field "Search" with "Wireless Mouse"
  expect css ".product-grid li" has count 0
  select "Electronics" from field "Category"
  expect css ".product-grid li" has count 1
  expect text "Wireless Mouse" is visible

@mixed
test "double click and right click are real, distinct browser events — not just two clicks"
  # M40: closes the zero-use gap for both steps. `double click`'s two clicks land at the *same*
  # screen coordinate (Playwright resolves the target position once, not per-click) — the first
  # opens the Quick View modal, whose full-viewport `.modal-overlay` (styles.css) then covers that
  # same point; since the row's button sits off-center (the overlay only centers `.modal-dialog`,
  # not the backdrop), the second click actually lands on the backdrop and closes it
  # (`ProductQuickViewModal.tsx`'s `e.target === e.currentTarget` self-close check) — a real,
  # observable proof the step fires two independent click events against the live DOM as it
  # changes between them, not a single coalesced "double-click" gesture. A right click never
  # dispatches a `click` event at all (browsers reserve it for `contextmenu`) — the add-to-cart
  # toast never appearing is what proves that, not an assumption.
  login(env(USER_A_EMAIL), env(USER_A_PW))
  open "/"
  fill field "Search" with "Bulk Item 5"
  within css "[aria-label='Bulk Item 5']"
    double click button "Quick view"
  expect button "Close" is hidden
  fill field "Search" with "Bulk Item 6"
  within css "[aria-label='Bulk Item 6']"
    right click button "Add to cart"
  expect text "Added 1 × Bulk Item 6 to your cart." is hidden

@mixed
test "the a11y-demo's accessible checkbox check/uncheck is real, after scroll to + hover"
  # M40: closes check field/uncheck field/hover/scroll to together — a11y-demo's accessible
  # checkbox (AccessibilityDemoPage.tsx) is real, labelled, and public (no login needed, App.tsx's
  # route table). `scroll to` + `hover` land on its neighbouring "Save preferences" button first
  # (a realistic "arrive, then act" sequence), then check/uncheck is verified against the field's
  # actual `checked` state, not just "the click didn't error".
  open "/a11y-demo"
  expect field "Subscribe to updates" not is checked
  scroll to button "Save preferences"
  hover button "Save preferences"
  check field "Subscribe to updates"
  expect field "Subscribe to updates" is checked
  uncheck field "Subscribe to updates"
  expect field "Subscribe to updates" not is checked

@mixed
test "the render fixture: a masked snapshot absorbs a real checkbox change, unmasked catches it"
  # M41 (PLAN_WEBV2_M40.md decision 4) first put this baseline on AccessibilityDemoPage's accessible
  # half; M45 (PLAN_WEBV2_M45.md) moved it here after that page's inherited global `system-ui` font
  # (styles.css) turned out to render differently across machines — the exact CI-vs-dev mismatch
  # this test caught for real (960x141 baseline vs. CI's 960x133). `/render-fixture` exists purely
  # to remove that variable: a self-hosted `.render-fixture` font (styles.css) instead of the host
  # OS's system font, plus the same lowest-flake-risk shape M41 already chose — static markup, no
  # seeded product data, no per-render dynamic ids, a public route (`webV2/src/App.tsx`) so no
  # login/auth-rehydration race either.
  #
  # Proves `mask` genuinely changes the compare outcome rather than just being asserted in
  # isolation — mirrors tflw's own M4b runtime test (`runtime/test/browser-steps.test.ts:1000`,
  # "unmasked fails on the recolored region, masked passes despite it"). This page's only real
  # source of visual state change is its checkbox: checking it unmasked genuinely differs from the
  # unchecked baseline (caught below via `not matches snapshot`); masking that same region — plus
  # the status-circle <img> — absorbs the change and still matches.
  #
  # Baselines were seeded once via `tflw run --update-snapshots --only "<this test's name>"` against
  # a temporarily-neutralized copy of this test (checkbox left unchecked throughout, so both names'
  # baselines capture the canonical unchecked state) — `--update-snapshots` overwrites on *every*
  # `matches snapshot` call it sees (`snapshot.ts`'s `evaluateSnapshot`), so seeding this file's
  # real, stateful version directly would let the later (checked-state) captures below clobber what
  # the first capture of each name just wrote. Committed baselines under
  # `tests/snapshots/webv2-storefront/…` are the product of that one-time seed; every ordinary
  # `tflw run` after that only ever reads and compares.
  open "/render-fixture"
  expect css "section[aria-labelledby='render-fixture-heading']" matches snapshot "render-fixture-unmasked"
  check field "Subscribe to updates"
  expect css "section[aria-labelledby='render-fixture-heading']" not matches snapshot "render-fixture-unmasked"
  uncheck field "Subscribe to updates"
  expect css "section[aria-labelledby='render-fixture-heading']" matches snapshot "render-fixture-masked" mask field "Subscribe to updates" mask css "section[aria-labelledby='render-fixture-heading'] img"
  check field "Subscribe to updates"
  expect css "section[aria-labelledby='render-fixture-heading']" matches snapshot "render-fixture-masked" mask field "Subscribe to updates" mask css "section[aria-labelledby='render-fixture-heading'] img"

@mixed
test "the order confirmation page's receipt link genuinely opens a second browser tab"
  # M43 (PLAN_WEBV2_M40.md decision 5): closes the `switch to new tab`/`switch to tab N`/`close tab`
  # gap — GET /orders/:id/receipt (M32) was already real and owner-scoped, just unconsumed by any
  # UI; wired up as a `target="_blank"` link on OrderConfirmationPage.tsx (nginx proxies `/v1/*`
  # same-origin, so the session cookie rides along with no bearer token needed). The receipt's own
  # PDF content/headers are already thoroughly proven at the API level (tests/order-receipts.tflw,
  # tests/file-formats.tflw's `body pdf text`) — re-asserting that here would be redundant, so this
  # test's job is the browser-tab mechanics only.
  #
  # Confirmed empirically before writing this for real (not assumed): a `target="_blank"` link to a
  # `Content-Disposition: attachment` response still fires Playwright's popup event — the new Page
  # opens before the browser's own download handling takes over — so `switch to new tab` genuinely
  # arms and catches it here, same as tflw's own runtime fixture (`browser-steps.test.ts:495`).
  api GET /products?q=Bulk%20Item%2050&pageSize=1
  expect status equals 200
  capture body[0].id as bulk50Id
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as token
  api POST /orders body { items: [{ productId: {bulk50Id}, quantity: 1 }] }
    header "Authorization" is "Bearer {token}"
  expect status equals 201
  capture body.id as orderId

  login(env(USER_A_EMAIL), env(USER_A_PW))
  open "/orders/{orderId}"
  expect text "Order confirmed" is visible
  switch to new tab
    click text "View receipt (PDF)"
  switch to tab 1
  expect text "Order confirmed" is visible
  switch to tab 2
  close tab
  expect text "Order confirmed" is visible

@mixed
test "the cart's Remove confirm() dialog: dismiss keeps the item, accept removes it via a real DELETE"
  # M43 (PLAN_WEBV2_M40.md decision 5): closes the `accept dialog`/`dismiss dialog` gap on the
  # storefront side — DELETE /cart/items/:id was already real and owner-scoped, just never
  # previously guarded by a native dialog. Dismissing first and confirming the row survives is what
  # proves this is a genuine confirm()-guarded trap (Playwright otherwise auto-dismisses silently,
  # SPEC §9.1), not just a click that happens to do nothing.
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as flushToken
  api POST /cart/checkout
    header "Authorization" is "Bearer {flushToken}"
  # T4's own flush precondition (cart rows are drag-drop reorderable test, above): a 422 "cart is
  # empty" here is expected and fine when nothing carried over from an earlier test.

  root("Bulk Item 51")
  within css "[aria-label='Bulk Item 51']"
    click button "Add to cart"
  expect text "Added 1 × Bulk Item 51 to your cart." is visible

  open "/cart"
  dismiss dialog
  click button "Remove Bulk Item 51"
  expect css "th[scope='row']:text-is('Bulk Item 51')" is visible

  accept dialog
  click button "Remove Bulk Item 51"
  expect text "Your cart is empty." is visible
  api GET /cart
    header "Authorization" is "Bearer {flushToken}"
  expect status equals 200
  expect body.items has count 0

@mixed
test "the happy-path product and catalog pages have no accessibility violations"
  api GET /products?q=Bulk%20Item%20100&pageSize=1
  expect status equals 200
  capture body[0].id as bulk100Id
  login(env(USER_A_EMAIL), env(USER_A_PW))
  open "/products/{bulk100Id}"
  expect page has no a11y violations
  open "/"
  expect page has no a11y violations

@mixed
test "the a11y-demo's inaccessible section: the scanner catches real violations, and severity is a floor not an exact match"
  # M48 (PLAN_WEBV2_M45.md): no test in this suite had ever proven the a11y scanner actually
  # catches a real violation — the test above only ever scans clean happy-path pages — despite
  # AccessibilityDemoPage.tsx being purpose-built with 4 deliberate violations for exactly this.
  # Real axe-core severities probed empirically first, not guessed: color-contrast → serious,
  # image-alt → critical, label → critical. (The 4th deliberate violation — a role-less clickable
  # <div> standing in for a button — isn't flagged by axe-core's default ruleset at all; not every
  # bad practice is a rule violation.)
  #
  # `not has no moderate a11y violations` is the real floor-vs-exact-match discriminator: zero
  # violations here are literally tagged "moderate" — only serious/critical exist — so this only
  # passes under genuine floor semantics (serious/critical count as "moderate or worse"); an
  # exact-match bug would incorrectly report this floor clean. Same reasoning for `minor`. A
  # genuinely-passing floor (a level above every real violation) isn't reachable on this page
  # without new target-app content — critical is axe's own ceiling, and this page has critical
  # violations — deliberately out of scope for this milestone (PLAN_WEBV2_M45.md: no target-app
  # work for M48).
  open "/a11y-demo"
  expect page not has no a11y violations
  expect page not has no minor a11y violations
  expect page not has no moderate a11y violations
  expect page not has no serious a11y violations
  expect page not has no critical a11y violations
