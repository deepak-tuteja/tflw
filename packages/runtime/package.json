{
  "name": "@tflw/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "testFlow runtime — interpreter over the AST, fetch binding, event stream, taint tracking, and (M3a) the Playwright-backed browser step driver.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tflw/lang": "*",
    "ajv": "^8.17.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "undici": "^8.7.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "axe-core": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.12.1",
    "playwright": "^1.62.0"
  }
}
