test "API steps"
  api GET /health
  api POST /orders body { name: "Widget", qty: 1 }
  api POST /orders body from "./fixtures/order.json"
  api POST /notes body text "plain words"
  api POST /graphql body graphql "query O($id: ID!) { order(id: $id) { id } }" variables { id: {orderId} } operation "O"
  api POST /login form email="a@b.c", password="secret"
  api POST /tickets/42/attachments upload "./before.png" as "files" type "image/png" form title="Checkout"
  api billing GET /invoices timeout 5s without redirects
  api POST /payments
    header "Idempotency-Key" is unique("pay")
    retry honoring "Retry-After" up to 3
    sign with stripe then body { amount: 1 }
  wait until api GET /orders/{orderId} timeout wait 30s
    expect body.state equals "shipped"
