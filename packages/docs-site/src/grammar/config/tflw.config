require env SHOPPER_EMAIL, SHOPPER_PW
exclude "drafts/**"
helpers "./helpers"
runs keep 20

defaults
  header "Accept" is "application/json"
  timeout step 10s, wait 30s
  workers 4
  report "report"
  evidence headers only
  redact header "Authorization", body.password, query "token"
  viewport 1280 800
  log level info
  log destination both
  allow hosts "api.example.com"

env staging default
  api "https://api.staging.example.com"
  api billing "https://billing.staging.example.com"
  web "https://staging.example.com"
  insecure false
  cert "./certs/client.pem"
  key "./certs/client.key"
  authorized target "https://api.staging.example.com" reason "our own staging stack"
    probe mutating
    probe oversized

signer stripe hmac sha256 hex secret env(STRIPE_WEBHOOK_SECRET)
  signs "{timestamp}.{body}"
  header "Stripe-Signature" is "t={timestamp},v1={signature}"
signer aws sigv4 region "eu-west-1" service "execute-api" key env(AWS_ACCESS_KEY_ID) secret env(AWS_SECRET_ACCESS_KEY)

session shopper
  api POST /auth/login body { email: env(SHOPPER_EMAIL), password: env(SHOPPER_PW) }
  capture body.token as token
  header "Authorization" is "Bearer {token}"
  csrf from body.csrfToken send as header "X-CSRF-Token"

session billing oauth2 privileged
  token url "https://auth.example.com/oauth/token"
  client id env(OAUTH_CLIENT_ID)
  client secret env(OAUTH_CLIENT_SECRET)
  scope "billing.read"

session sso oauth2 code
  authorize url "/oauth/authorize"
  token url "/oauth/token"
  client id "storefront-cli"
  redirect "http://127.0.0.1:0/callback"
  fill field "Email" with env(SHOPPER_EMAIL)
  click button "Allow"

session partner signed with stripe
  header "X-Partner" is "acme"
