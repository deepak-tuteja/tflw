---
// `M269` (`D1443`) — Starlight's content wrapper, plus the page's `pageClass`. Three pages-wide hooks
// earn one: `ui-shots` (the `/ui/` pages and the walkthrough's chapter on the page, whose screenshots
// break out of the text column), `grammar-page` (each section's formal productions folded under
// its glance) and `reference-page` (`M270`: the reference pages drawn as entries). All three are in
// `src/styles/custom.css`, with their reasons.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const { pageClass } = Astro.locals.starlightRoute.entry.data;
---

{pageClass ? <div class={pageClass}><Default><slot /></Default></div> : <Default><slot /></Default>}

<script>
  /**
   * **Press a picture to read it** — `M234` `G` (`D1305`).
   *
   * The `/ui/` shots are cut at 1440 or 1060 css and land in a content column far narrower than
   * that, so the UI's 13px type arrives at around 6px. `deviceScaleFactor: 2` buys the resolution;
   * nothing was buying the *size*. `medium-zoom` was refused (`D1305`): it would be this site's first
   * runtime dependency, and the backdrop has to be theme-aware for the `.light-only`/`.dark-only`
   * pairs either way.
   *
   * Three ways out, because a reader who cannot dismiss an overlay is trapped in it: a press
   * anywhere, `Escape`, and a scroll. The page is **not** scroll-locked while the overlay is up —
   * locking it would remove the very gesture that dismisses it.
   */
  let overlay: HTMLElement | null = null;
  let opener: HTMLElement | null = null;

  const close = (): void => {
    if (overlay === null) return;
    overlay.remove();
    overlay = null;
    // Focus goes back where it came from, not to the top of the document.
    opener?.focus?.();
    opener = null;
  };

  document.addEventListener('click', (event) => {
    // An overlay that is up swallows the next press, whatever it landed on — so pressing the
    // enlarged picture itself closes rather than re-opening it.
    if (overlay !== null) {
      close();
      return;
    }
    const target = event.target as HTMLElement | null;
    if (target === null || target.tagName !== 'IMG') return;
    // Content pictures only: the logo, the hero and anything a component draws are not the subject.
    if (target.closest('.sl-markdown-content') === null) return;

    const source = target as HTMLImageElement;
    overlay = document.createElement('div');
    overlay.className = 'tflw-zoom';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', source.alt === '' ? 'the picture, enlarged' : source.alt);
    overlay.tabIndex = -1;

    const big = document.createElement('img');
    // `currentSrc`, not `src`: the light/dark pair is chosen by CSS, and `src` on a hidden member of
    // the pair would enlarge the picture the reader is not looking at.
    big.src = source.currentSrc === '' ? source.src : source.currentSrc;
    big.alt = source.alt;
    overlay.append(big);

    document.body.append(overlay);
    opener = source;
    overlay.focus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
  window.addEventListener('scroll', close, { passive: true });
</script>

<script>
  /**
   * **The diagnostics filter** — `M270` (`D-M270-3`). Narrows the page's entries to those whose text
   * holds every word typed, so `session` or `timeout tab` each find their codes, and a code (`TF041`,
   * or the start of one) finds that code. No dependency and no index: 87 entries are read off the
   * page once.
   *
   * An entry is an `h3.tflw-entry` (inside the wrapper Starlight puts round a heading) and everything
   * after it up to the next entry or stage heading. A stage heading is hidden when none of its
   * entries is shown, so the page never shows an empty section.
   */
  const input = document.querySelector<HTMLInputElement>('#tflw-filter-input');
  const content = input?.closest('.sl-markdown-content');
  if (input && content) {
    const isEntry = (e: Element): boolean => e.matches('h3.tflw-entry') || e.querySelector(':scope > h3.tflw-entry') !== null;
    const isStage = (e: Element): boolean => e.matches('h2') || e.querySelector(':scope > h2') !== null;
    type Entry = { parts: Element[]; text: string; code: string };
    const stages: { head: Element; entries: Entry[] }[] = [];
    let entry: Entry | null = null;
    for (const child of [...content.children]) {
      if (isStage(child)) {
        stages.push({ head: child, entries: [] });
        entry = null;
      } else if (isEntry(child) && stages.length > 0) {
        entry = { parts: [child], text: '', code: (child.matches('h3') ? child : child.querySelector('h3'))?.id ?? '' };
        stages.at(-1)?.entries.push(entry);
      } else if (entry !== null) entry.parts.push(child);
    }
    const all = stages.flatMap((s) => s.entries);
    for (const e of all) e.text = e.parts.map((p) => p.textContent ?? '').join(' ').toLowerCase();
    const output = content.querySelector('.tflw-filter output');

    const apply = (): void => {
      const words = input.value.toLowerCase().split(/\s+/).filter((w) => w !== '');
      let shown = 0;
      for (const stage of stages) {
        let any = false;
        for (const e of stage.entries) {
          // A word shaped like a code (`tf04`, `TF041`) means that code, not every entry that mentions
          // it: TF042's text names TF041, and a reader typing TF041 wants TF041.
          const match = words.every((w) => (/^tf\d{0,3}$/.test(w) ? e.code.startsWith(w) : e.text.includes(w)));
          for (const p of e.parts) p.classList.toggle('tflw-filtered', !match);
          if (match) {
            any = true;
            shown++;
          }
        }
        stage.head.classList.toggle('tflw-filtered', !any);
      }
      if (output) output.textContent = words.length === 0 ? '' : `${shown} of ${all.length} codes`;
    };
    input.addEventListener('input', apply);
  }
</script>

<script>
  /**
   * **A link into a fold opens it** — `M270` (`D-M270-6`). The Changelog folds every entry after the
   * newest few, and each keeps its heading id, so a link to one lands — but on a heading inside a
   * closed `<details>`, which the browser cannot scroll to. This opens the fold that holds the
   * target and brings it into view, on load and whenever the hash changes.
   */
  const reveal = (): void => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id === '') return;
    const target = document.getElementById(id);
    const fold = target?.closest('details');
    if (target === null || fold === null || fold === undefined || fold.open) return;
    fold.open = true;
    target.scrollIntoView();
  };
  reveal();
  window.addEventListener('hashchange', reveal);
</script>
