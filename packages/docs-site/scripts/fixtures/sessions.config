# The session names a ```tflw sample may opt into with `test "…" as <name>` (M62, DT-04).
#
# Appended to `tflw.config` for the `.tflw` samples only. The guide declares a session on one page
# and opts into it a block or two later; without this, every such sample fails `TF028` for
# continuing its own page. Declaring the names here keeps the check live where it earns its keep —
# a *typo'd* session name still fails, because it isn't on this list.
#
# `oauth2` because it is the shape that needs no companion `.tflw` steps. What each session does is
# irrelevant to a parse-and-check run; only the name is.

session admin oauth2
  token url "http://127.0.0.1:9/token"
  client id "docs"
  client secret "docs"

session customer oauth2
  token url "http://127.0.0.1:9/token"
  client id "docs"
  client secret "docs"

# M130b — guide chapter 15 teaches `has no authorization violations`, whose whole subject is one
# principal's resources being probed for by another. Two more names, because that page's samples are
# only truthful if they show both halves: an owner (`as shopper`) and somebody the oracle re-issues
# the request as (`as peer`, in an emitted repro).
session shopper oauth2
  token url "http://127.0.0.1:9/token"
  client id "docs"
  client secret "docs"

session peer oauth2
  token url "http://127.0.0.1:9/token"
  client id "docs"
  client secret "docs"

# M246 — the signers `guide/signed-requests.md` signs with, and the session it opts into. Literal
# secrets, because what a signer does is irrelevant to a parse-and-check run; only the name is.
signer stripe hmac sha256 hex secret "docs"
  signs "{timestamp}.{body}"
  header "Stripe-Signature" is "t={timestamp},v1={signature}"

signer github hmac sha256 hex secret "docs"
  signs "{body}"
  header "X-Hub-Signature-256" is "sha256={signature}"

signer aws sigv4 region "eu-west-1" service "execute-api" key "docs" secret "docs"

session partner signed with stripe oauth2
  token url "http://127.0.0.1:9/token"
  client id "docs"
  client secret "docs"
