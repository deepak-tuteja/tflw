{
  "name": "@tflw/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "tflw documentation site (VitePress) — deployed to GitHub Pages.",
  "type": "module",
  "scripts": {
    "brand": "node scripts/generate-brand-assets.mjs",
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "test": "node --test scripts/*.test.mjs && node scripts/verify-docs.mjs",
    "test:links": "node scripts/verify-links.mjs && node scripts/verify-sidebars.mjs"
  },
  "dependencies": {
    "@tflw/lang": "*",
    "@tflw/lsp-server": "*"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
