{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tflw",
  "scopeName": "source.tflw",
  "fileTypes": ["tflw"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#tags" },
    { "include": "#strings" },
    { "include": "#pipe-tables" },
    { "include": "#http-request" },
    { "include": "#env-call" },
    { "include": "#keywords-statement" },
    { "include": "#keywords-subject" },
    { "include": "#keywords-matcher" },
    { "include": "#keywords-generator" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.tflw",
      "match": "#.*$"
    },
    "tags": {
      "name": "entity.name.tag.tflw",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "strings": {
      "name": "string.quoted.double.tflw",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.tflw", "match": "\\\\." },
        { "name": "variable.interpolation.tflw", "match": "\\{[^}\"]*\\}" }
      ]
    },
    "pipe-tables": {
      "name": "punctuation.separator.pipe.tflw",
      "match": "\\|"
    },
    "http-request": {
      "comment": "`api [<service>] GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS /path`",
      "match": "\\b(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS)\\b(\\s+)(/\\S*)?",
      "captures": {
        "1": { "name": "keyword.control.http-method.tflw" },
        "3": { "name": "string.unquoted.path.tflw" }
      }
    },
    "env-call": {
      "comment": "env(NAME) — a taint-tracked secret reference, distinct from the `env <name>` config block keyword",
      "match": "\\benv(?=\\s*\\()",
      "name": "support.function.env.tflw"
    },
    "keywords-statement": {
      "comment": "M4a: includes the M3a-M3e browser-step keywords (open/click/.../stub) and their sub-clause words (on/to/onto/dialog/new/tab/frame/respond), catching up parser.ts's STATEMENT_KEYWORDS. M4b adds `mask` (the `mask <locator>` snapshot-masking clause).",
      "match": "\\b(test|action|before|after|session|import|use|api|expect|check|let|capture|wait|until|give|require|env|default|defaults|workers|report|timeout|retry|with|each|from|as|without|redirects|upload|form|header|body|type|open|click|double|right|fill|select|uncheck|press|hover|scroll|within|accept|dismiss|switch|close|download|drag|drop|screenshot|stub|on|to|onto|dialog|new|tab|frame|respond|mask)\\b",
      "name": "keyword.control.tflw"
    },
    "keywords-subject": {
      "comment": "M4a: includes the M3a/M3e locator-noun and `page` subjects (button/field/list/css/xpath/page), catching up parser.ts's SUBJECT_KEYWORDS.",
      "match": "\\b(status|duration|text|bytes|request|button|field|list|css|xpath|page)\\b",
      "name": "support.type.tflw"
    },
    "keywords-matcher": {
      "comment": "M4a: includes `was`/`made` (M3d `was made`) and `no`/`a11y`/`violations`/severity words (M3e `has no [<severity>] a11y violations`). M4b adds `snapshot` (`matches snapshot \"<name>\"`).",
      "match": "\\b(equals|contains|matches|subset|file|has|is|not|count|value|greater|less|than|visible|hidden|enabled|disabled|checked|any|all|connects|fails|matching|was|made|no|a11y|violations|minor|moderate|serious|critical|snapshot)\\b",
      "name": "keyword.operator.word.tflw"
    },
    "keywords-generator": {
      "match": "\\b(unique|random|like|of|number|decimal|date|in|past|future|between|and|string|email|today|now|format|base64|hex|url|encode|decode)\\b",
      "name": "support.function.generator.tflw"
    },
    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.tflw"
    },
    "numbers": {
      "match": "\\b\\d+(\\.\\d+)?(ms|s|m|h)?\\b",
      "name": "constant.numeric.tflw"
    },
    "operators": {
      "match": "[+\\-*/=]",
      "name": "keyword.operator.tflw"
    }
  }
}
