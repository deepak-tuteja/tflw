{
  "name": "tflw-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "testFlow — a testing-only DSL (.tflw / tflw CLI). Monorepo root.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepak-tuteja/tflw.git"
  },
  "license": "MIT",
  "author": "Deepak Tuteja <33311251+deepak-tuteja@users.noreply.github.com>",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/lang",
    "packages/runtime",
    "packages/reporter",
    "packages/lsp-server",
    "packages/cli",
    "packages/ui",
    "packages/vscode",
    "packages/docs-site"
  ],
  "scripts": {
    "test": "node scripts/verify-test-counts.mjs",
    "test:raw": "npm run test --workspaces --if-present",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "coverage": "node scripts/coverage.mjs",
    "verify:observability": "node scripts/verify-test-observability.mjs",
    "verify:mutations": "node scripts/mutate.mjs",
    "sweep": "node scripts/sweep.mjs",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "verify:corpora": "node scripts/verify-corpora.mjs",
    "verify:lang-build": "node scripts/verify-lang-build.mjs",
    "verify:fmt-roundtrip": "node scripts/verify-fmt-roundtrip.mjs",
    "verify:check-coverage": "node scripts/verify-check-coverage.mjs",
    "verify:decisions": "node scripts/gen-decisions.mjs --check",
    "verify:citations": "node scripts/verify-citations.mjs",
    "verify:anchors": "node scripts/verify-anchors.mjs",
    "verify:zero-match": "node scripts/verify-zero-match.mjs",
    "verify:zero-match:self-test": "node scripts/verify-zero-match.mjs --self-test",
    "verify:no-internal-refs": "node scripts/verify-no-internal-refs.mjs",
    "verify:no-internal-refs:self-test": "node scripts/verify-no-internal-refs.mjs --self-test",
    "verify:sibling-pin": "node scripts/verify-sibling-pin.mjs",
    "verify:sibling-pin:self-test": "node scripts/verify-sibling-pin.mjs --self-test",
    "verify:own-identifiers": "node scripts/verify-own-identifiers.mjs",
    "verify:settled-reads": "node scripts/verify-settled-reads.mjs --check",
    "verify:settled-reads:oracle": "node scripts/verify-settled-reads.mjs --oracle",
    "verify:settled-reads:self-test": "node scripts/verify-settled-reads.mjs --self-test",
    "verify:settled-reads:update": "node scripts/verify-settled-reads.mjs --update",
    "report:settled-reads": "node scripts/verify-settled-reads.mjs",
    "verify:own-identifiers:self-test": "node scripts/verify-own-identifiers.mjs --self-test",
    "refresh:own-identifiers": "node scripts/refresh-own-identifiers.mjs",
    "docs:decisions": "node scripts/gen-decisions.mjs",
    "docs:provenance": "node scripts/gen-decisions.mjs --provenance",
    "docs:demand": "node scripts/gen-decisions.mjs --demand",
    "example": "node examples/storefront/run.mjs --tag functional",
    "example:ui": "node packages/cli/dist/cli.cjs ui examples/storefront",
    "example:load": "node examples/storefront/run.mjs --tag workload",
    "example:pacing": "node examples/storefront/run.mjs --tag pacing",
    "verify:coverage-floors": "node scripts/coverage-floors.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sarif": "^2.1.7",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
