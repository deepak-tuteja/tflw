node_modules/
dist/
*.tsbuildinfo
*.vsix
.env
report/

# c8 coverage output (decision: M21) — regenerated by `npm run coverage`, never committed
coverage/
.nyc_output/
packages/cli/LICENSE
packages/vscode/LICENSE

# M92a (review `B6-06`) — third-party attribution, generated from each bundle's own esbuild
# metafile by scripts/third-party-notices.mjs. Committing it would make it a second source of truth
# that can disagree with the bundle, which is the drift the generator exists to remove.
packages/cli/THIRD-PARTY-NOTICES.md
packages/vscode/THIRD-PARTY-NOTICES.md
# The metafile those are derived from — a build byproduct, kept outside `dist/` so `files: ["dist"]`
# cannot ship it, and read by pack.test.ts so the guard needs no copy of the build config.
packages/cli/.bundle-meta.json
packages/vscode/.bundle-meta.json

# Regenerated from SPEC.md by packages/cli/scripts/gen-docs.mjs (pretest/predev/bundle) — never
# hand-edited, so it isn't a source of truth worth committing.
packages/cli/src/docs-data.generated.ts

# VitePress build output/cache (packages/docs-site) — dist/ above already covers .vitepress/dist,
# this adds the separate cache directory.
**/.vitepress/cache

# Internal dev-tracking docs (decision log + build tracker) — not part of the public project
PLAN.md
PROGRESS.md
PLAN_*.md

# Pre-1.0 launch-review corpus (PLAN_LAUNCH_REVIEW.md): the master fix queue REVIEW_FINDINGS.md,
# the per-pass ledgers behind it, the freeze-surface record and the fresh-user friction log. These
# are internal working notes — every row is an unfixed defect with a reproduction — and stay local.
REVIEW_*.md

# M123 — `scripts/mutate.mjs`'s crash journal, for the case where there is no `.git` to put it in
# (a tarball or a vendored copy; the normal location is `<git-dir>/tflw-mutate-journal.json`, which
# cannot be committed at all). It holds the pre-mutation contents of a tracked source and exists
# only while a sweep is running or after one died — never something to commit.
.tflw-mutate-journal.json

# M127 — a sharded sweep's manifest (`mutate.mjs --manifest=`), the record CI reassembles the
# registry from. Written at the end of a run, uploaded as an artifact, and meaningful only for the
# revision that produced it — a committed one would be a stale claim about which mutations ran.
shard-*.json

# Per-milestone scratch: probes, fixtures and pulled artifacts from a slice in progress.
# Never committed — `M147f` swept one into a commit and caught it in review. Untracked by
# convention since `.m140-scratch/`; a pattern is cheaper than remembering.
.m*-scratch/
