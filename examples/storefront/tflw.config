# The example storefront's config. `tflw ui .` from this directory opens it. Start the shop with
# `node server.mjs` (`npm run shop` in a project `tflw init --example` wrote) and `tflw run`.
#
# Every URL here reads `SHOP_URL` first and falls back to 4720. The shop reads the same variable, so
# when 4720 is taken, `export SHOP_URL=http://127.0.0.1:4721` moves both.
#
# `authorized target` is what lets `scan.tflw` run at all (`TF060`): a crawl issues requests
# nobody wrote, so the language makes you name the thing you are allowed to point it at, with a
# reason, in the file a reviewer reads. It names the loopback server beside this config and
# nothing else.
defaults
  timeout api 5s
  viewport 900 600
  authorized target env SHOP_URL default "http://127.0.0.1:4720" reason "the example storefront in this directory, on loopback"

env local default
  api env SHOP_URL default "http://127.0.0.1:4720"
  web env SHOP_URL default "http://127.0.0.1:4720"
