# The example storefront's config. `tflw ui .` from this directory opens it; `npm run example`
# from the repository root starts the server and runs the suite.
#
# `authorized target` is what lets `scan.tflw` run at all (`TF060`): a crawl issues requests
# nobody wrote, so the language makes you name the thing you are allowed to point it at, with a
# reason, in the file a reviewer reads. It names the loopback server beside this config and
# nothing else.
defaults
  timeout api 5s
  viewport 900 600
  authorized target "http://127.0.0.1:4720" reason "the example storefront in this directory, on loopback, started by `npm run example`"

env local default
  api "http://127.0.0.1:4720"
  web "http://127.0.0.1:4720"
