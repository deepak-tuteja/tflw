{
  "all": true,
  "src": [
    "packages/lang/src",
    "packages/runtime/src",
    "packages/reporter/src",
    "packages/lsp-server/src",
    "packages/ui/src",
    "packages/cli/src",
    "packages/vscode/src"
  ],
  "exclude-after-remap": true,
  "exclude": [
    "**/dist/**",
    "**/test/**",
    "**/*.test.ts",
    "**/*.generated.ts",
    "**/node_modules/**"
  ],
  "reporter": [
    "text",
    "lcov"
  ],
  "reports-dir": "coverage",
  "check-coverage": true,
  "statements": 89,
  "lines": 89,
  "branches": 88,
  "functions": 81
}
