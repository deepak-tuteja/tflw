# Acceptance benchmark config (PLAN.md decision 41/50, M7's 1.0 gate): 5 representative scenarios
# from testFlow-tests' webV2 dogfood target (its own repo — see testFlow-tests/tests/webv2-*.tflw
# for the full ~10-test corpus this is drawn from), reused here for an apples-to-apples comparison
# against acceptance/webv2/raw/. Needs testFlow-tests' Docker stack running
# (`node cli.mjs start` in that repo) before either side can run.

env local default
  api "http://localhost:4001/v1"
  web "http://localhost:8090"

require env USER_A_EMAIL, USER_A_PW
