# M36 (D41) — points at echo-server-delayed-connlog.mjs, a controlled slow local target used to
# ground-truth whether tflw's own generator sustains VU-count concurrency against a realistically
# slow (not zero-latency) server. Separate directory from ../tflw.config specifically so this never
# gets accidentally run against the fast profiling target or the real app.

env local default
  api "http://127.0.0.1:4503"
