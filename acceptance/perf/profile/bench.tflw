# M35a profiling scenario — same GET-then-POST shape as acceptance/perf/tflw/checkout-burst.tflw,
# against echo-server.mjs instead of the real contended endpoint, so a CPU profile isolates the
# generator's own per-request overhead from real network/DB latency.

test "profile bench"
  ramp to 30 users over 8s
  api GET /products
  expect status equals 200
  capture body[0].id as productId
  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
  expect status equals 201
