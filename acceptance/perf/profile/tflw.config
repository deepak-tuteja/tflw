# M35a profiling config — points at echo-server.mjs (zero-latency, no auth needed), not the real
# testFlow-tests target acceptance/perf/tflw/tflw.config uses. Kept as its own config specifically
# so this profiling harness never accidentally fires against the real app.

env local default
  api "http://127.0.0.1:4099"

# M37 sanity check (D46) — a trivial, zero-latency session so bench-session.tflw can measure the
# per-iteration `sessionCache.ensure()` call's own overhead in isolation. bench.tflw (no session)
# is unaffected: it never opts into `as bench`.
session bench
  api POST /login
  capture body.token as tok
  header "Authorization" is "Bearer {tok}"
